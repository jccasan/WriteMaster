{
  "$name": "James D. May Books",
  "$version": "1.0.0",
  "$source": "Derived from the Oracle Veil Book 1 front cover and the approved JAMES D. MAY BOOKS wordmark.",
  "$note": "Hex values were eyedropped from the supplied JPEG/PNG as rendered. JPEG compression shifts flat fields by a few units. Re-sample against the layered cover file before any press run.",

  "color": {
    "ink":        { "value": "#102229", "rgb": "16, 34, 41",    "use": "Dominant background. Every dark surface." },
    "slate":      { "value": "#1C3743", "rgb": "28, 55, 67",    "use": "Secondary surface. Cards, panels, table rows, input fills." },
    "fog":        { "value": "#49C2D6", "rgb": "73, 194, 214",  "use": "The astrolabe glow. Light only, 8% to 24% opacity. Never a fill, never type." },
    "bone":       { "value": "#EAE7E1", "rgb": "234, 231, 225", "use": "All display type. Primary text on dark surfaces." },
    "signal":     { "value": "#D4141B", "rgb": "212, 20, 27",   "use": "The cover red. Display type, the reticle centre dot, the series strap. Display sizes only." },
    "signalFill": { "value": "#C31219", "rgb": "195, 18, 25",   "use": "Interactive fills only. Primary buttons. Bone on this passes WCAG AA at 4.97:1." },
    "signalPress":{ "value": "#A51015", "rgb": "165, 16, 21",   "use": "Pressed and active state of a signalFill surface." },
    "ember":      { "value": "#DD5A1E", "rgb": "221, 90, 30",   "use": "Photography and illustration only. Never UI, never type, never a fill." }
  },

  "contrast": {
    "bone-on-ink":     { "ratio": 13.26, "aa": true,  "aaa": true  },
    "bone-on-slate":   { "ratio": 10.15, "aa": true,  "aaa": true  },
    "fog-on-ink":      { "ratio": 7.77,  "aa": true,  "aaa": true  },
    "bone-on-signalFill": { "ratio": 4.97, "aa": true, "aaa": false },
    "bone-on-signal":  { "ratio": 4.35,  "aa": false, "aaLarge": true, "note": "Do not set UI text on signal. Use signalFill." },
    "signal-on-ink":   { "ratio": 3.05,  "aa": false, "aaLarge": true, "note": "Display sizes only, 24px/18.66px bold and above." },
    "ember-on-ink":    { "ratio": 4.33,  "aa": false, "aaLarge": true, "note": "Ember never carries text. Listed for reference only." },
    "slate-on-ink":    { "ratio": 1.31,  "aa": false, "note": "Surface separation, not a text pair. Add a 1px rgba(234,231,225,0.10) hairline." }
  },

  "type": {
    "family": {
      "display": "\"Druk Condensed\", Oswald, \"Arial Narrow\", sans-serif",
      "ui":      "Inter, -apple-system, \"Segoe UI\", sans-serif",
      "reading": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif"
    },
    "weight": {
      "displayMedium": 600, "displayHeavy": 700,
      "uiRegular": 400, "uiSemibold": 600,
      "readingRegular": 400
    },
    "scale": {
      "ds-100": { "size": "12px", "lineHeight": "16px", "tracking": "0.08em" },
      "ds-200": { "size": "14px", "lineHeight": "20px", "tracking": "0.01em" },
      "ds-300": { "size": "16px", "lineHeight": "26px", "tracking": "0" },
      "ds-400": { "size": "20px", "lineHeight": "30px", "tracking": "0" },
      "ds-500": { "size": "25px", "lineHeight": "32px", "tracking": "-0.01em" },
      "ds-600": { "size": "32px", "lineHeight": "36px", "tracking": "-0.02em" },
      "ds-700": { "size": "42px", "lineHeight": "44px", "tracking": "-0.02em" },
      "ds-800": { "size": "56px", "lineHeight": "56px", "tracking": "-0.03em" }
    }
  },

  "space": {
    "unit": "4px",
    "s-1": "4px", "s-2": "8px", "s-3": "12px", "s-4": "16px",
    "s-5": "24px", "s-6": "32px", "s-7": "48px", "s-8": "64px", "s-9": "96px"
  },

  "radius": { "none": "0", "sm": "2px", "note": "The system is square. 2px is the maximum on any surface. The reticle is the only circle." },

  "cover": {
    "trim":        { "ebook": "1600x2560", "paperback6x9": "1800x2700" },
    "sideMargin":  "8%",
    "strapBaseline": "4.0%",
    "strapCapHeight": "1.1%",
    "strapTracking": "0.28em",
    "titleBandTop": "38%",
    "titleBandBaseline": "73%",
    "titleOpticalWidth": "76% to 82% of trim width",
    "authorBaseline": "93%",
    "authorCapHeight": "2.8%",
    "authorTracking": "0.20em"
  },

  "reticle": {
    "grid": "100 units, tick tip to tick tip",
    "ringOuterRadius": 31, "ringStroke": 5,
    "tickLength": 19, "tickStroke": 5, "tickCount": 4, "tickRule": "all four equal",
    "centreDotRadius": 9, "centreDotFill": "signal",
    "ruleStroke": 5, "ruleBreakGap": 14
  }
}
